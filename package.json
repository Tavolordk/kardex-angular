{
  "name": "kardex-policial-sspc",
  "version": "1.2.0",
  "scripts": {
    "ng": "ng",
    "assets:figma": "node scripts/sync-figma-assets.mjs",
    "postinstall": "npm run assets:figma",
    "prestart": "npm run assets:figma",
    "start": "ng serve --host 0.0.0.0 --port 4205 --proxy-config proxy.conf.cjs --poll 1000",
    "build": "ng build",
    "build:with-assets": "npm run assets:figma && ng build",
    "test": "ng test",
    "start:local": "ng serve --host 127.0.0.1 --port 4205 --proxy-config proxy.conf.cjs",
    "start:network": "ng serve --host 0.0.0.0 --port 4205 --proxy-config proxy.conf.cjs --poll 1000"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "typescript": "~5.9.2"
  }
}
