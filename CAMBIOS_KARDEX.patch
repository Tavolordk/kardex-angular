+.document-button input { display: none; }
+.file-chip { min-width: 0; max-width: 100%; height: 38px; display: flex; align-items: center; gap: 8px; padding: 0 8px 0 12px; border: 1px solid rgba(114,129,150,.18); border-radius: 12px; background: rgba(255,255,255,.72); color: #4c5561; }
+.file-chip span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font: 500 12px var(--font-body); }
+.file-chip button { width: 24px; height: 24px; flex: 0 0 auto; border: 0; border-radius: 50%; background: rgba(185,110,110,.12); color: #8b3f3f; cursor: pointer; font-size: 18px; line-height: 20px; }
