+.subsection-heading p { margin: 0; color: #737c87; font: 400 12px/16px var(--font-body); }
+.segmented { min-width: 160px; display: grid; grid-template-columns: 1fr 1fr; padding: 3px; border: 1px solid rgba(114,129,150,.16); border-radius: 12px; background: rgba(114,129,150,.1); }
